rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(householdId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /households/{householdId} {
      allow read: if isMember(householdId);
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isMember(householdId);
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      match /members/{memberId} {
        allow read: if isMember(householdId);
        allow create: if signedIn() && request.auth.uid == memberId;
        allow update: if isMember(householdId) && (request.auth.uid == memberId || request.auth.uid == get(/databases/$(database)/documents/households/$(householdId)).data.createdBy);
        allow delete: if isMember(householdId) && (request.auth.uid == memberId || request.auth.uid == get(/databases/$(database)/documents/households/$(householdId)).data.createdBy);
      }

      match /expenses/{expenseId} {
        allow read: if isMember(householdId);
        allow create: if isMember(householdId) && request.resource.data.paidBy == request.auth.uid;
        allow update, delete: if isMember(householdId) && resource.data.paidBy == request.auth.uid;
      }
    }
  }
}
