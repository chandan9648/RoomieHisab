rules_version = '2';

/**
 * RoomieHisab security rules.
 *
 * Principles:
 *  - Nothing is readable or writable without an authenticated user.
 *  - Household data is reachable only by members of that household, checked on
 *    every single read and write — never inferred from the client.
 *  - `households` and `invites` can never be listed, only fetched by exact id.
 *    This is what lets an invite code act as a credential without exposing
 *    every flat in the project to a collection query.
 *  - Writes are shape-validated here as well as in the UI, so a hand-rolled
 *    SDK call cannot store a negative amount, a 10MB note or someone else's uid.
 *  - Only the payer of an expense or a household admin may edit or delete it.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function memberDoc(hid, memberId) {
      return /databases/$(database)/documents/households/$(hid)/members/$(memberId);
    }

    function isMember(hid) {
      return signedIn() && exists(memberDoc(hid, uid()));
    }

    function isAdmin(hid) {
      return isMember(hid) && get(memberDoc(hid, uid())).data.role == 'admin';
    }

    // `get()` inside rules bypasses rules, so this works while the caller is
    // still bootstrapping their own membership row.
    function isCreator(hid) {
      return signedIn()
        && get(/databases/$(database)/documents/households/$(hid)).data.createdBy == uid();
    }

    /** True when `code` is a live invite for exactly this household. */
    function inviteOpens(code, hid) {
      return code is string
        && code.size() >= 6 && code.size() <= 10
        && exists(/databases/$(database)/documents/invites/$(code))
        && get(/databases/$(database)/documents/invites/$(code)).data.householdId == hid;
    }

    function validHousehold(d) {
      return d.keys().hasAll(['name', 'createdBy', 'inviteCode', 'createdAt'])
        && d.keys().hasOnly(['name', 'createdBy', 'inviteCode', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.createdBy is string
        && d.inviteCode is string && d.inviteCode.size() >= 6 && d.inviteCode.size() <= 10
        && d.createdAt is number;
    }

    function validMember(d, memberId) {
      return d.keys().hasAll(['uid', 'displayName', 'email', 'photoURL', 'joinedAt', 'role', 'joinedVia'])
        && d.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'joinedAt', 'role', 'joinedVia'])
        && d.uid == memberId
        && d.displayName is string && d.displayName.size() > 0 && d.displayName.size() <= 80
        && d.email is string && d.email.size() <= 320
        && (d.photoURL == null || d.photoURL is string)
        && d.joinedAt is number
        && (d.role == 'admin' || d.role == 'member')
        && d.joinedVia is string && d.joinedVia.size() <= 10;
    }

    /**
     * Mirrors `src/lib/validation.ts` and `parseAmountToPaise`. The cap is
     * ₹1,00,00,000 expressed in paise, matching MAX_AMOUNT_PAISE.
     */
    function validExpense(hid, d) {
      return d.keys().hasAll(['description', 'amountPaise', 'date', 'paidBy', 'payerName', 'notes', 'createdAt'])
        && d.keys().hasOnly(['description', 'amountPaise', 'date', 'paidBy', 'payerName', 'notes', 'createdAt'])
        && d.description is string && d.description.size() > 0 && d.description.size() <= 80
        && d.amountPaise is int && d.amountPaise > 0 && d.amountPaise <= 1000000000
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.paidBy is string && exists(memberDoc(hid, d.paidBy))
        && d.payerName is string && d.payerName.size() > 0 && d.payerName.size() <= 80
        && d.notes is string && d.notes.size() <= 200
        && d.createdAt is number;
    }

    // ------------------------------------------------------------- user profile

    /**
     * Private to its owner. It holds only the id of the active household and the
     * list of households joined; nothing here grants access to a household,
     * because every household read re-checks the `members` subcollection.
     */
    match /users/{userId} {
      allow get: if signedIn() && uid() == userId;
      allow list: if false;
      allow write: if signedIn() && uid() == userId;
    }

    // ------------------------------------------------------------------ invites

    /**
     * `invites/{CODE}` maps an invite code to one household. `get` is open to any
     * signed-in user — that is the point of an invite — but `list` is denied, so
     * codes cannot be enumerated and the collection cannot be scraped.
     */
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['code', 'householdId', 'householdName', 'createdBy', 'createdAt'])
        && request.resource.data.keys().hasOnly(['code', 'householdId', 'householdName', 'createdBy', 'createdAt'])
        && request.resource.data.code == code
        && code.size() >= 6 && code.size() <= 10
        && request.resource.data.createdBy == uid()
        && request.resource.data.householdId is string
        && request.resource.data.householdName is string
        && request.resource.data.householdName.size() <= 60
        && request.resource.data.createdAt is number
        && (isCreator(request.resource.data.householdId) || isAdmin(request.resource.data.householdId));

      // Rotating a code is "create the new one, delete the old one", never an
      // in-place edit, so a code can never be repointed at another household.
      allow update: if false;
      allow delete: if signedIn()
        && (isCreator(resource.data.householdId) || isAdmin(resource.data.householdId));
    }

    // --------------------------------------------------------------- households

    match /households/{hid} {
      allow get: if isMember(hid);
      // Denied so that nobody can search households by invite code or name.
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.createdBy == uid()
        && validHousehold(request.resource.data);

      // Admins may rename the flat and rotate the invite code; identity and
      // creation time are immutable.
      allow update: if isAdmin(hid)
        && validHousehold(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if signedIn() && resource.data.createdBy == uid();

      // ------------------------------------------------------------- members

      match /members/{memberId} {
        // Your own row is readable whether or not you are in this household, so
        // a client can ask "am I already in here?" while redeeming an invite.
        // Without this, that question is itself a permission error, and a first
        // join fails before it starts. It tells the caller nothing about anyone
        // but themselves. Listing the roster still requires membership.
        allow get: if signedIn() && (uid() == memberId || isMember(hid));
        allow list: if isMember(hid);

        /**
         * Two ways in, and no others:
         *  1. The household creator bootstrapping their own admin row, directly
         *     after creating the household document.
         *  2. Anyone who presents a live invite code for this household. They
         *     always join as a plain `member`, so a role cannot be self-assigned.
         */
        allow create: if signedIn()
          && uid() == memberId
          && validMember(request.resource.data, memberId)
          && (
            (isCreator(hid)
              && request.resource.data.role == 'admin'
              && request.resource.data.joinedVia == '')
            ||
            (request.resource.data.role == 'member'
              && inviteOpens(request.resource.data.joinedVia, hid))
          );

        // A member may refresh their own profile fields but never their role;
        // an admin may change roles. Join metadata is immutable either way.
        allow update: if signedIn()
          && validMember(request.resource.data, memberId)
          && request.resource.data.joinedAt == resource.data.joinedAt
          && request.resource.data.joinedVia == resource.data.joinedVia
          && (
            (uid() == memberId && request.resource.data.role == resource.data.role)
            || isAdmin(hid)
          );

        // Leaving (self) or being removed by an admin.
        allow delete: if signedIn() && (uid() == memberId || isAdmin(hid));
      }

      // ------------------------------------------------------------ expenses

      match /expenses/{expenseId} {
        allow read: if isMember(hid);

        // You log your own spending. An admin may also log on a roommate's
        // behalf, and the payer must be a current member of this household.
        allow create: if isMember(hid)
          && validExpense(hid, request.resource.data)
          && (request.resource.data.paidBy == uid() || isAdmin(hid));

        // Payer and creation time are fixed: an expense can be corrected, but
        // never reassigned to someone else or back-dated in the feed.
        allow update: if isMember(hid)
          && validExpense(hid, request.resource.data)
          && request.resource.data.paidBy == resource.data.paidBy
          && request.resource.data.createdAt == resource.data.createdAt
          && (resource.data.paidBy == uid() || isAdmin(hid));

        allow delete: if isMember(hid)
          && (resource.data.paidBy == uid() || isAdmin(hid));
      }
    }
  }
}
