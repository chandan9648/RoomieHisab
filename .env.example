# Copy this file to .env.local and paste in your Firebase web app config.
#
# Firebase console -> Project settings -> General -> Your apps -> Web app -> SDK
# setup and configuration -> Config.
#
# These NEXT_PUBLIC_* values are shipped to the browser by design. They identify
# the project; they are not secrets. All real protection comes from
# firestore.rules. Never put an Admin SDK service-account key in this file or
# anywhere under src/.

NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# --- Optional: make redirect sign-in reliable on phones ---------------------
#
# Leave NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN as <project>.firebaseapp.com and the
# app signs in with a popup everywhere. That works, but on phones a popup can
# be blocked or discarded when the browser switches tabs.
#
# To use the sturdier full-page redirect on mobile, point authDomain at this
# app's own domain. `next.config.ts` already proxies /__/auth/* through to the
# Firebase handler, so the handler stops being a third-party origin:
#
#   NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=roomie-hisab.vercel.app
#
# Both the app domain and <project>.firebaseapp.com must be listed under
# Firebase console -> Authentication -> Settings -> Authorised domains.
# Deploy the rewrite first, then flip this value.
